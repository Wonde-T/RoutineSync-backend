NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Either provide a single connection string (recommended for hosted databases)...
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# ...or set the individual values below.
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USERNAME=routinesync
DB_PASSWORD=routinesync
DB_NAME=routinesync
# DB_SSL=true
DB_SYNCHRONIZE=true

JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=30d

# Password reset emails. Leave SMTP_HOST unset in development: the reset code
# is written to the server log instead of being emailed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=change-me
# MAIL_FROM=RoutineSync <no-reply@example.com>
